    {
      "name": "12. [ADMIN] Получить всех пользователей",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Users list returned', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.users).to.be.an('array');",
              "});",
              "",
              "// Сохраняем ID первого пользователя для теста повышения",
              "var jsonData = pm.response.json();",
              "if (jsonData.users && jsonData.users.length > 0) {",
              "    var regularUser = jsonData.users.find(u => u.role === 'user');",
              "    if (regularUser) {",
              "        pm.collectionVariables.set('userId', regularUser._id);",
              "        console.log('✅ User ID saved:', regularUser._id);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/admin/users",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "admin", "users"]
        },
        "description": "Получение списка всех пользователей (только для админа)"
      },
      "response": []

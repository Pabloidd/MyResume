    {
      "name": "15. [INTERNAL] Валидация токена",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Token is valid', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.valid).to.eql(true);",
              "    pm.expect(jsonData).to.have.property('userId');",
              "    pm.expect(jsonData).to.have.property('role');",
              "});"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Получаем токен из cookie",
              "var cookies = pm.cookies.all();",
              "var authCookie = cookies.find(c => c.name === 'authToken');",
              "if (authCookie) {",
              "    pm.collectionVariables.set('authToken', authCookie.value);",
              "} else {",
              "    console.log('⚠️ Токен не найден. Сначала выполните логин.');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
